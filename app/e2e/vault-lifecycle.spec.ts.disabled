/**
 * Full vault lifecycle E2E: deploy → deposit → announce → reveal → redeem.
 *
 * Verifies that 0.001 ETH actually lands in the recipient's wallet after redeem.
 * Runs the full BLS12-381 blind signature protocol against a real NozkVaultV2
 * contract on local anvil.
 *
 * Requires: anvil running on localhost:8545 (chain ID 31337 = 0x7a69)
 *           forge build artifacts in sol/out/
 */

import { test, expect } from '@playwright/test'
import { type Address } from 'viem'
import {
  deployNozkVault,
  depositAndAnnounce,
  revealToken,
  redeemToken,
  getBalance,
  getNullifierState,
  DENOMINATION,
  RECIPIENT,
  publicClient,
  getVaultAddress,
} from './fixtures/contract-setup'
import { injectMockWallet, MOCK_ACCOUNT_ADDRESS } from './fixtures/mock-wallet'

const ANVIL_RPC = 'http://127.0.0.1:8545'
const CHAIN_ID_HEX = '0x7a69'
const TEST_SEED = new TextEncoder().encode('playwright_e2e_lifecycle_test')

test.describe('Vault lifecycle E2E', () => {
  // Deploy contract once for all tests in this suite
  test.beforeAll(async () => {
    const addr = await deployNozkVault()
    console.log(`NozkVaultV2 deployed at ${addr}`)
  })

  test('full lifecycle: deposit → announce → reveal → redeem sends 0.001 ETH to recipient', async () => {
    // ----------------------------------------------------------------
    // 1. Deposit + announce (simulates user deposit + mint daemon)
    // ----------------------------------------------------------------
    const { secrets, S } = await depositAndAnnounce(TEST_SEED, 0)

    // ----------------------------------------------------------------
    // 2. Reveal (registers nullifier on-chain)
    // ----------------------------------------------------------------
    await revealToken(TEST_SEED, 0, S)

    // ----------------------------------------------------------------
    // 3. Get recipient balance BEFORE redeem
    // ----------------------------------------------------------------
    const balBefore = await getBalance(RECIPIENT)

    // ----------------------------------------------------------------
    // 4. Redeem (sends 0.001 ETH to recipient)
    // ----------------------------------------------------------------
    const { nullifierId } = await redeemToken(TEST_SEED, 0, RECIPIENT)

    // ----------------------------------------------------------------
    // 5. Verify: recipient received exactly 0.001 ETH
    // ----------------------------------------------------------------
    const balAfter = await getBalance(RECIPIENT)
    const received = balAfter - balBefore
    expect(received).toBe(DENOMINATION)

    // ----------------------------------------------------------------
    // 6. Verify: nullifier is marked SPENT (state=2)
    // ----------------------------------------------------------------
    const state = await getNullifierState(nullifierId)
    expect(state).toBe(2)
  })

  test('redeem to a different recipient also transfers correct amount', async () => {
    // Use a different recipient (anvil account 5)
    const otherRecipient = '0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc' as Address

    // Deposit + announce token index 1
    const { S } = await depositAndAnnounce(TEST_SEED, 1)

    // Reveal
    await revealToken(TEST_SEED, 1, S)

    // Balance before
    const balBefore = await getBalance(otherRecipient)

    // Redeem to different recipient
    await redeemToken(TEST_SEED, 1, otherRecipient)

    // Verify balance increased by exactly 0.001 ETH
    const balAfter = await getBalance(otherRecipient)
    expect(balAfter - balBefore).toBe(DENOMINATION)
  })

  test('contract denomination matches expected 0.001 ETH', async () => {
    const denom = await publicClient.readContract({
      address: getVaultAddress(),
      abi: (await import('./fixtures/contract-setup')).getAbi(),
      functionName: 'DENOMINATION',
    })
    expect(denom).toBe(DENOMINATION)
  })

  test('revealed token shows activity in the app UI', async ({ page }) => {
    // Deposit + announce token index 2
    const { S } = await depositAndAnnounce(TEST_SEED, 2)

    // Reveal token
    await revealToken(TEST_SEED, 2, S)

    // Now load the app pointed at the deployed contract
    // Note: the app uses VITE_NOZK_VAULT_ADDRESS from .env.test, which may
    // differ from the deployed address. We can verify the contract state
    // independently and verify the UI renders a connected wallet.
    await injectMockWallet(page, {
      rpcUrl: ANVIL_RPC,
      chainIdHex: CHAIN_ID_HEX,
      account: MOCK_ACCOUNT_ADDRESS,
    })
    await page.goto('/')
    await expect(page.locator('#splash')).toBeHidden({ timeout: 15_000 })
    await expect(page.getByText('PRIVATE BALANCE')).toBeVisible({ timeout: 5_000 })

    // The app is loaded and connected — the contract state (reveal, redeem) is
    // verified by the Node-side assertions above. The UI shows the dashboard.
    await page.screenshot({ path: 'e2e/screenshots/vault-lifecycle-dashboard.png', fullPage: true })
  })
})
